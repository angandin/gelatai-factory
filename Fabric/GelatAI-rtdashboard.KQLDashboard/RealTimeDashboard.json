      "text": "machinesraw_normalized\r\n| where attribute_name == \"temperature\"\r\n| summarize arg_max(timestamp, *) by machine_id\r\n| join kind=inner external_table('machineparameters') on $left.machine_id==$right.machine_id and $left.attribute_name==$right.attribute_name\r\n| extend isAnomaly = iff(attribute_value_decimal >= min_value and attribute_value_decimal <= max_value, false, true)\r\n| project machine_id, attribute_value_decimal, isAnomaly",
      "id": "597e8440-61d4-4062-8c0f-a9925bcbc4be",
