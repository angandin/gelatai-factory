table tokenconsumption
	lineageTag: b0000000-0000-0000-0000-000000000001
	sourceLineageTag: [dbo].[tokenconsumption]

	/// Total tokens = input + output + cached
	measure 'Total Tokens' = SUM(tokenconsumption[input_tokens]) + SUM(tokenconsumption[output_tokens]) + SUM(tokenconsumption[cached_tokens])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000101

	measure 'Input Tokens' = SUM(tokenconsumption[input_tokens])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000102

	measure 'Output Tokens' = SUM(tokenconsumption[output_tokens])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000103

	measure 'Cached Tokens' = SUM(tokenconsumption[cached_tokens])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000104

	/// Total tokens consumed today (based on the report refresh date)
	measure 'Tokens Today' = CALCULATE([Total Tokens], FILTER(ALL(tokenconsumption[timeday]), tokenconsumption[timeday] = TODAY()))
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000105

	/// Total tokens consumed in the current calendar month
	measure 'Tokens This Month' = CALCULATE([Total Tokens], FILTER(ALL(tokenconsumption[timeday]), YEAR(tokenconsumption[timeday]) = YEAR(TODAY()) && MONTH(tokenconsumption[timeday]) = MONTH(TODAY())))
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000106

	measure 'Active Agents' = DISTINCTCOUNT(tokenconsumption[gen_ai_agent_id])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000107

	measure 'Active Projects' = DISTINCTCOUNT(tokenconsumption[foundryProject])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000108

	measure 'Active Users' = DISTINCTCOUNT(tokenconsumption[user_mail])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-000000000109

	measure Conversations = DISTINCTCOUNT(tokenconsumption[trace_conversation_id])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-00000000010a

	measure 'Avg Tokens / Conversation' = DIVIDE([Total Tokens], [Conversations])
		formatString: #,0
		lineageTag: b0000000-0000-0000-0000-00000000010b

	measure 'Cache Hit Rate' = DIVIDE(SUM(tokenconsumption[cached_tokens]), [Total Tokens])
		formatString: 0.0%
		lineageTag: b0000000-0000-0000-0000-00000000010c

