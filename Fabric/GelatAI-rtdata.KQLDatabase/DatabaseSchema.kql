// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table machinesraw (machine_id:string, machine_type:string, timestamp:string, state:string, payload:dynamic, EventProcessedUtcTime:datetime, PartitionId:long, EventEnqueuedUtcTime:datetime) 
.create-merge table machinesraw_normalized (machine_id:string, machine_type:string, timestamp:datetime, state:string, attribute_name:string, attribute_value_decimal:real) 
.create-or-alter function with (folder = "Normalization", docstring = "Normalize machinesraw payload into one row per numeric attribute, excluding anomaly", skipvalidation = "true") machinesraw_normalized_fn() {
    machinesraw
    | project-away EventProcessedUtcTime, EventEnqueuedUtcTime, PartitionId
    | extend pj = parse_json(payload)
    | extend attribute_name = bag_keys(pj)
    | mv-expand attribute_name to typeof(string)
    | where attribute_name != "anomaly"
    | extend raw_value = pj[attribute_name]
    | extend attribute_value_decimal = toreal(tostring(raw_value))
    | extend timestamp = todatetime(timestamp)
    | project machine_id, machine_type, timestamp, state, attribute_name, attribute_value_decimal
}
.create-or-alter function with (folder = "Normalization", docstring = "Extract only temperature from machinesraw payload", skipvalidation = "true") machinesraw_temperature_fn() {
    machinesraw
    | project-away EventProcessedUtcTime, EventEnqueuedUtcTime, PartitionId
    | extend pj = parse_json(payload)
    | extend temperature = toreal(tostring(pj.temperature))
    | where isnotnull(temperature)
    | extend timestamp = todatetime(timestamp)
    | project machine_id, machine_type, timestamp, state, temperature
}
.alter table machinesraw_normalized policy update "[{\"IsEnabled\":true,\"Source\":\"machinesraw\",\"Query\":\"machinesraw_normalized_fn()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":true,\"ManagedIdentity\":null,\"OwnerPrincipalDetails\":\"fdd3a89e-3e31-4d87-8bd3-60b25886f05b;94e2fbfd-171c-4f8c-9b70-fbe8002dac58\"}]"
