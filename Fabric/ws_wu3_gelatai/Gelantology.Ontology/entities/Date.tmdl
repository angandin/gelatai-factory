			valueColumn: Date.Date

		synonym 'Calendar Date'

		synonym 'Sales Date'

	property Year
		dataType: int64
		lineageTag: 19d08abc-1f19-4a05-84cb-1c1c220ce387

		backingConfiguration
			valueColumn: Date.Year

	/// Numeric month within the year.
