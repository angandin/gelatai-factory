relationship 'Shop Availability to Shop'
	fromColumn: 'Shop Availability'.'Shop ID'
	toColumn: Shop.'Shop ID'

relationship 'Shop Availability to Product'
	fromColumn: 'Shop Availability'.'Product ID'
	toColumn: Product.'Product ID'

relationship 'Shipment Flow to Product'
	fromColumn: 'Shipment Flow'.'Product ID'
	toColumn: Product.'Product ID'

relationship 'Inventory to Shop'
	fromColumn: Inventory.'Shop ID'
	toColumn: Shop.'Shop ID'

relationship 'Inventory to Product'
	fromColumn: Inventory.'Product ID'
	toColumn: Product.'Product ID'

relationship 'Shipment to Shop'
	fromColumn: Shipment.'Shop ID'
	toColumn: Shop.'Shop ID'

relationship 'Shipment Flow to Shipment'
	fromColumn: 'Shipment Flow'.'Shipment ID'
	toColumn: Shipment.'Shipment ID'

relationship 'Shipment Flow to Production Batch'
	fromColumn: 'Shipment Flow'.'Production Batch ID'
	toColumn: 'Production Batch'.'Production Batch ID'

