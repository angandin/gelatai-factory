model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - GelatAI_lakehouse","DirectLake - GelatAI_shopdb"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","MCP-PBIModeling-Hosted"]

ref table machineanomalies
ref table machinesraw_normalized
ref table machineparameters
ref table Shop
ref table Product
ref table 'Shop Availability'
ref table 'Shipment Flow'
ref table Inventory
ref table Shipment
ref table 'Production Batch'

