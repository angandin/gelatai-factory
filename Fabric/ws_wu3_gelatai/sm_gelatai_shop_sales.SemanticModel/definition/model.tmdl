model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

ref table 'Sales'
ref table 'Shop'
ref table 'Flavor'
ref table 'Date'
ref table 'Currency'
ref table 'Weather'
ref table 'Payment'
ref table 'Channel'
ref table 'Serving'
ref table 'Local Hour'
ref table 'Refresh'

ref expression 'DirectLake - Shop Sales'
